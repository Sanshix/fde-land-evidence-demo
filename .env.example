# Copy to .env and fill only the credentials for the provider you choose.
# Keep .env local. Providers remain disabled until explicitly configured.
AI_GUIJILIUDONG_SECRET=
AI_ALIYUN_KEY=
AI_BAIDU_KEY=
AI_BAIDU_SECRET=

# Baidu AI OCR: application API Key + Secret Key, exchanged for an access_token.
# Qianfan V2 uses a separate Bearer API key; never substitute application AK.
AI_BAIDU_QIANFAN_API_KEY=
